# Copy to .env (or set these in your shell / hosting panel).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
# Reverse proxies in front of Django that set X-Forwarded-For (0 = none). The PIN
# sign-in throttle keys on the client IP: behind one proxy (nginx, a PaaS router) set 1.
DJANGO_NUM_PROXIES=0
# Optional: where the SQLite file lives (defaults to ./db.sqlite3)
SQLITE_PATH=
