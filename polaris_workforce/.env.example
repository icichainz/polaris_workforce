# Copy to .env (or set these in your shell / hosting panel). Nothing loads .env by
# itself: export the variables (e.g. `set -a; . ./.env; set +a`) or set them in the
# process manager.

# Local development only. Without it DEBUG is off (production behaviour) and
# DJANGO_SECRET_KEY is required: `DJANGO_DEBUG=true uv run python manage.py runserver`.
DJANGO_DEBUG=true
# Production: 50+ random characters, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(60))". Leave empty locally.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
# Reverse proxies in front of Django that set X-Forwarded-For (0 = none). The PIN
# sign-in throttle and the office sign-in lockout key on the client IP: behind one proxy
# (nginx, a PaaS router) set 1.
DJANGO_NUM_PROXIES=0
# Optional: where the SQLite file lives (defaults to ./db.sqlite3)
SQLITE_PATH=
# Optional: seconds a database connection is kept between requests (default 60, 0 = reopen
# for every request)
DJANGO_CONN_MAX_AGE=
# Optional: uploaded photos and proofs (defaults to ./media). Never served directly.
MEDIA_ROOT=

# How a protected file is sent once access is checked: django (default), nginx
# (X-Accel-Redirect to PROTECTED_MEDIA_INTERNAL_URL) or apache (X-Sendfile).
PROTECTED_MEDIA_MODE=django
PROTECTED_MEDIA_INTERNAL_URL=/protected-media/

# Shared cache for the throttles and lockouts (file-based; defaults to ./var/cache).
DJANGO_CACHE_DIR=

# Office sign-in lockout: wrong passwords per (username, IP), and how long it lasts.
DJANGO_LOGIN_MAX_ATTEMPTS=5
DJANGO_LOGIN_LOCKOUT_MINUTES=15

# A phone's device token stops working after this many days without use.
DEVICE_TOKEN_IDLE_DAYS=30

# Production HTTPS (ignored while DJANGO_DEBUG=true).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
