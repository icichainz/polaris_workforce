# docker compose settings: copy to .env (never commit .env).

# Required. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
TRACKER_SHARED_SECRET=

# Port nginx listens on, on this machine.
POLARIS_PORT=8080

# Host names / IPs the app answers to. Add this machine's LAN IP for the phone app,
# e.g. localhost,127.0.0.1,192.168.1.20 — and the matching origin below.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_TIME_ZONE=UTC

# Plain HTTP for local use. Behind HTTPS set both to true (and consider HSTS).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0

# Messaging: "log" writes texts (and phone numbers, portal PINs) to the container log.
MESSAGING_PROVIDER=log
DEVICE_TOKEN_IDLE_DAYS=30

# Background jobs (Celery worker; its queue is the redis service). Keep it small: every
# task writes to the one SQLite file.
CELERY_CONCURRENCY=2

# Presence tracker. TRACKER_SHARED_SECRET (above) signs the tokens between Django, the
# tracker, phones and browsers: at least 32 random characters. TRACKER_PUBLIC_URL is the
# tracker as phones and browsers reach it (through nginx at /tracker); use this machine's
# network address when phones connect. TRACK_RETENTION_DAYS must match the companies'
# "track retention days" setting.
TRACKER_PUBLIC_URL=http://localhost:8080/tracker
TRACK_RETENTION_DAYS=30
